# Ciliar — autenticação e permissões.
APP_URL=http://localhost:3101
NEXT_PUBLIC_APP_URL=http://localhost:3101
PORT=3101
NEXT_PUBLIC_BASE_PATH=
APP_OWNER_NAME=Ciliar
APP_ORIGIN=http://localhost:3101
# Gere um segredo próprio com: openssl rand -base64 32. Nunca copie o do Opex/Shekinah.
AUTH_SECRET=

# Banco exclusivo do Ciliar; nunca aponte para o banco do Opex.
# Precisa ser replica set: alterações de autoridade usam transações. Não altere um Mongo compartilhado.
# directConnection evita o hostname interno do replica set Docker no desenvolvimento local.
MONGODB_URI=mongodb://127.0.0.1:27017/ciliar?directConnection=true
# Compose usa o hostname da rede mongodb-network, não 127.0.0.1.
# Em Mongo autenticado, inclua o usuário/senha exclusivos do Ciliar e authSource=ciliar.
DOCKER_MONGODB_URI=mongodb://mongodb:27017/ciliar?directConnection=true
# Apenas no CLI fora do Docker: traduza este hostname da URI para 127.0.0.1.
SCRIPT_MONGODB_HOST=mongodb
# Se a porta publicada for diferente da interna, informe-a aqui:
SCRIPT_MONGODB_PORT=

# Gere com: openssl rand -base64 32. Não troque depois de salvar segredos.
INTEGRATIONS_ENCRYPTION_KEY=
CRON_SECRET=

# Fallback legado opcional. Configure preferencialmente em /integracoes.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_MODE=
PUSHER_CLUSTER=
PUSHER_URL=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_URL=
LOG_LEVEL=info
